# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# NOTE: keep this file UTF-8 encoded. PowerShell 5 `>` / Out-File writes UTF-16,
# which git cannot parse (every rule silently stops working).

# dependencies (any package: frontend/, backend/)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
coverage/
.nyc_output/

# next.js & build output
.next/
out/
build/
dist/
.turbo

# misc & OS files
.DS_Store
Thumbs.db
*.pem
*.local

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (only templates are committed)
.env*
!.env.example

# vercel
.vercel

# typescript build cache
*.tsbuildinfo
next-env.d.ts

# clerk configuration (keyless dev keys / secrets)
.clerk/

# frontend mirror of the backend-owned Prisma schema (see frontend/scripts/generate-prisma-client.mjs)
frontend/prisma/

# agent skills collection & local agent caches
.agents/skills/
.agent/skills/
.agents/scratch/
.agent/scratch/
.gemini/
.claude/
temp_skills/
scratch/
tmp/
temp/

# office documents & Word backups (personal reports are kept outside the repo)
*.wbk
~$*
/*.docx

# IDE & editors
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
