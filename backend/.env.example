# ===========================================
# ShelfSync Backend (Express REST API) Environment
# Copy to backend/.env and fill in real values. Never commit backend/.env.
# ===========================================

# --- HTTP server ---
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN="http://localhost:3000"

# --- Database (PostgreSQL via Prisma + pg pool) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
# Direct/session endpoint used by `prisma migrate`; blank falls back to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DB_POOL_MAX=10

# --- Clerk (bearer-token verification) ---
CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"

# --- Telegram contact channel ---
TELEGRAM_BOT_TOKEN="123456789:your_bot_token"
TELEGRAM_CHAT_ID="123456789"
