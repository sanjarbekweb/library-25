// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Enums
// ============================================

enum UserRole {
  STUDENT
  ASSISTANT
  ADMIN
}

enum CopyCondition {
  MINT
  GOOD
  FAIR
  DAMAGED
}

enum CopyStatus {
  AVAILABLE
  RESERVED
  BORROWED
  MAINTENANCE
  LOST
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum ReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

enum HistoryAction {
  CREATED
  CHECKOUT
  CHECKIN
  RESERVED
  RESERVATION_FULFILLED
  RESERVATION_CANCELLED
  RESERVATION_EXPIRED
  CONDITION_CHANGE
  STATUS_CHANGE
  LOST
  MAINTENANCE
}

enum DomainEntityType {
  BOOK
  BOOK_COPY
  USER
  FEEDBACK
  RESERVATION
  LOAN
  INTEGRATION
  SYSTEM
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// Models
// ============================================

/// User synced from Clerk via webhook.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String
  lastName  String
  role      UserRole @default(STUDENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  heldCopies     BookCopy[]    @relation("CurrentHolder")
  loans          Loan[]        @relation("StudentLoans")
  assistedLoans  Loan[]        @relation("AssistantLoans")
  reservations   Reservation[]
  feedbacks      Feedback[]
  historyActions BookHistory[] @relation("HistoryActor")

  @@index([clerkId])
  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@index([role, isActive])
  @@map("users")
}

/// Catalog book entry (title-level metadata).
model Book {
  id              String   @id @default(cuid())
  title           String
  author          String
  isbn            String?  @unique
  category        String
  description     String?  @db.Text
  coverImageUrl   String?
  publicationYear Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  copies       BookCopy[]
  reservations Reservation[]
  feedbacks    Feedback[]

  @@index([title])
  @@index([author])
  @@index([category])
  @@index([isbn])
  @@index([createdAt])
  @@index([category, createdAt])
  @@map("books")
}

/// Individual physical copy of a book.
model BookCopy {
  id              String        @id @default(cuid())
  bookId          String
  barcode         String        @unique
  condition       CopyCondition @default(MINT)
  status          CopyStatus    @default(AVAILABLE)
  currentHolderId String?
  version         Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  book          Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  currentHolder User?         @relation("CurrentHolder", fields: [currentHolderId], references: [id], onDelete: SetNull)
  loans         Loan[]
  reservations  Reservation[]
  history       BookHistory[]

  @@index([bookId])
  @@index([status])
  @@index([barcode])
  @@index([currentHolderId])
  @@index([bookId, status])
  @@map("book_copies")
}

/// Loan record tracking a checkout/return cycle.
model Loan {
  id          String     @id @default(cuid())
  bookCopyId  String
  studentId   String
  assistantId String
  borrowedAt  DateTime   @default(now())
  dueDate     DateTime
  returnedAt  DateTime?
  status      LoanStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  bookCopy  BookCopy  @relation(fields: [bookCopyId], references: [id], onDelete: Cascade)
  student   User      @relation("StudentLoans", fields: [studentId], references: [id], onDelete: Cascade)
  assistant User      @relation("AssistantLoans", fields: [assistantId], references: [id], onDelete: Cascade)
  feedback  Feedback?

  @@index([bookCopyId])
  @@index([studentId])
  @@index([assistantId])
  @@index([status])
  @@index([dueDate])
  @@index([borrowedAt])
  @@index([returnedAt])
  @@index([studentId, status])
  @@index([studentId, createdAt])
  @@index([status, dueDate])
  @@index([studentId, status, dueDate])
  @@index([bookCopyId, status])
  @@map("loans")
}

/// Immutable audit log for every BookCopy state change.
/// Records are append-only — Restrict on foreign keys prevents cascading destruction of history.
model BookHistory {
  id            String        @id @default(cuid())
  bookCopyId    String
  action        HistoryAction
  actorType     String        @default("USER") // USER | SYSTEM
  actorId       String?       // Foreign key to User when actorType is USER
  systemActor   String?       // Service principal identifier when actorType is SYSTEM
  actorRole     String?       // Role snapshot at event time
  previousState String?
  newState      String?
  notes         String?       @db.Text
  correlationId String?
  causationId   String?
  createdAt     DateTime      @default(now())

  // Relations - Restrict prevents accidental cascade-deletion of historical audit logs
  bookCopy BookCopy @relation(fields: [bookCopyId], references: [id], onDelete: Restrict)
  actor    User?    @relation("HistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([bookCopyId])
  @@index([actorId])
  @@index([action])
  @@index([actorType])
  @@index([createdAt])
  @@index([bookCopyId, createdAt])
  @@map("book_history")
}

/// Append-only DomainAudit for non-copy system events (Books, Users, Feedback, Integrations).
model DomainAudit {
  id            String           @id @default(cuid())
  entityType    DomainEntityType
  entityId      String
  action        String
  actorType     String           @default("USER") // USER | SYSTEM
  actorId       String?          // User ID if USER
  systemActor   String?          // Service principal identifier if SYSTEM
  actorRole     String?          // Role snapshot at event time
  beforeState   Json?
  afterState    Json?
  correlationId String?
  causationId   String?
  createdAt     DateTime         @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([actorType])
  @@index([createdAt])
  @@map("domain_audits")
}

/// Student reservation request for a book.
model Reservation {
  id         String            @id @default(cuid())
  bookId     String
  bookCopyId String?
  studentId  String
  expiresAt  DateTime
  status     ReservationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  // Relations
  book     Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookCopy BookCopy? @relation(fields: [bookCopyId], references: [id], onDelete: SetNull)
  student  User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([studentId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([studentId, status])
  @@index([studentId, status, expiresAt])
  @@index([bookId, status])
  @@index([bookCopyId, status])
  @@map("reservations")
}

/// Verified post-loan feedback (one per loan) or direct book review.
model Feedback {
  id          String   @id @default(cuid())
  bookId      String
  studentId   String
  loanId      String?  @unique
  rating      Int
  comment     String?  @db.Text
  isModerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  book    Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  loan    Loan? @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([studentId])
  @@index([rating])
  @@index([createdAt])
  @@index([bookId, isModerated])
  @@index([isModerated, createdAt])
  @@map("feedbacks")
}

/// Idempotency records for retryable mutations (circulation, reservations, admin actions).
model IdempotencyRecord {
  id             String   @id @default(cuid())
  key            String   @unique
  actorId        String
  operation      String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([actorId, operation])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// Transactional outbox for durable asynchronous event delivery.
model OutboxMessage {
  id          String       @id @default(cuid())
  eventType   String
  payload     Json
  status      OutboxStatus @default(PENDING)
  retryCount  Int          @default(0)
  lastError   String?      @db.Text
  lockedAt    DateTime?
  lockedBy    String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([lockedAt])
  @@map("outbox_messages")
}

/// Transactional inbox for deduplicating incoming webhooks and external events.
model InboxMessage {
  id          String   @id @default(cuid())
  eventId     String   @unique
  source      String
  payload     Json
  processedAt DateTime @default(now())

  @@index([source, eventId])
  @@map("inbox_messages")
}

/// Distributed worker lease coordination.
model WorkerLease {
  id        String   @id
  holder    String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("worker_leases")
}
