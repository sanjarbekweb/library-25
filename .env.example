# # ===========================================
# # ShelfSync Environment Configuration
# # Strict $0 (100% Free-Tier Infrastructure)
# # ===========================================
# # Copy this file to .env and fill in your actual credentials.

# # --- Database (Supabase PostgreSQL via Prisma) ---
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&statement_cache_size=0"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# # --- Clerk Authentication (Free Hobby Tier - up to 10,000 MAUs) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
# CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
# CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_secret"

# # --- Clerk Route Configuration ---
# NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
# NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/catalog"
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/catalog"
# NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL="/catalog"
# NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL="/catalog"

# # --- Meilisearch (Open-Source Standalone Local Binary - 100% Free) ---
# # Start binary command: meilisearch --master-key="shelfsync_meili_master_key_dev"
# MEILISEARCH_HOST="http://localhost:7700"
# MEILISEARCH_MASTER_KEY="shelfsync_meili_master_key_dev"
# MEILISEARCH_SEARCH_KEY="shelfsync_meili_search_key_dev"

# # --- Cloudflare R2 Cover Images (Free Tier - 10 GB storage, $0 egress fees) ---
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_BUCKET_NAME="shelfsync-covers"
# R2_PUBLIC_URL="https://your-r2-public-url.example.com"

# # --- Telegram Bot Direct Contact & Feedback Channel ---
# # Create a bot via Telegram's @BotFather to get your token.
# TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
# # Get your personal Chat ID or Group ID from @userinfobot or channel info.
# TELEGRAM_CHAT_ID="123456789"

