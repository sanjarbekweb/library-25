# # ===========================================
# # ShelfSync Environment Configuration
# # Local development template; production capacity must be qualified separately.
# # ===========================================
# # Copy this file to .env and fill in your actual credentials.

# # --- Database (Supabase PostgreSQL via Prisma) ---
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Verify endpoint mode/TLS with the provider: port 5432 here is a session pooler,
# not necessarily a direct database connection. Blank DIRECT_URL falls back to
# DATABASE_URL; only use that fallback for migrations on a supported endpoint.
# PrismaPg uses pg configuration below, not legacy Prisma URL pool options.
# Defaults apply when omitted; blank, zero, negative and oversized values fail.
# Ranges: pool max 1–100; connection/max-wait 1–30000ms;
# idle timeout 1–600000ms; transaction timeout 1–60000ms.
# Budget every process plus deployment surge against provider connection limits.
DB_POOL_MAX=10
# Remote TLS/auth connection setup exceeded 1s in development; qualify tighter
# limits in same-region staging rather than confusing connect timeout with SLO.
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_TRANSACTION_MAX_WAIT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=5000

# # --- Test Database (Required for integration tests; MUST be an isolated disposable/staging database) ---
# # Never point this to production data. The integration test rejects identical DATABASE_URL values.
# TEST_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@localhost:5432/library_test"
# Explicit test-only opt-in. Target must end in _test; URL query overrides are rejected.
# ALLOW_DATABASE_INTEGRATION_TESTS=true
# TEST_DATABASE_HOST_ALLOWLIST=localhost

# # --- Internal Service Principal Authentication ---
# # Secret used to authenticate internal background services (minimum 16 characters).
# INTERNAL_SERVICE_SECRET="your_min_16_char_secure_internal_service_secret"

# # --- Clerk Authentication (Free Hobby Tier - up to 10,000 MAUs) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
# CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
# CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_secret"

# # --- Clerk Route Configuration ---
# NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
# NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/catalog"
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/catalog"
# NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL="/catalog"
# NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL="/catalog"

# # --- Meilisearch (Open-Source Standalone Local Binary - 100% Free) ---
# # Start binary command: meilisearch --master-key="shelfsync_meili_master_key_dev"
# MEILISEARCH_HOST="http://localhost:7700"
# MEILISEARCH_MASTER_KEY="shelfsync_meili_master_key_dev"
# MEILISEARCH_SEARCH_KEY="shelfsync_meili_search_key_dev"

# # --- Cloudflare R2 Cover Images (Free Tier - 10 GB storage, $0 egress fees) ---
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_BUCKET_NAME="shelfsync-covers"
# R2_PUBLIC_URL="https://your-r2-public-url.example.com"

# # --- Telegram Bot Direct Contact & Feedback Channel ---
# # Create a bot via Telegram's @BotFather to get your token.
# TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
# # Get your personal Chat ID or Group ID from @userinfobot or channel info.
# TELEGRAM_CHAT_ID="123456789"

# # --- Backend REST API (Express, ../backend) ---
# NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
